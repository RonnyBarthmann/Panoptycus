# Panoptycus - maps.dat
# Kapitel, Karten, Tempel und Ruinen. (Menschenlesbar; Kommentare mit #.)
#
# AUFBAU
#   [map]      Ein Kartenlayout (Startpunkt, Monster, Wegpunkte). Jedes Kapitel besteht aus ALLEN hier
#              definierten Karten in dieser Reihenfolge: gibt es 10 [map]-Abschnitte, hat jedes Kapitel 10 Karten.
#              Die Koordinaten beziehen sich auf die Kartenkacheln aus maps.c (Pixel, y nach unten).
#   [chapter]  Ein Kapitel. Die Karten eines Kapitels wachsen linear von level_first (erste Karte) bis
#              level_last (letzte Karte) im Monster-Level. Anzahl Kapitel = Anzahl [chapter]-Abschnitte.
#   [temple]   Tempel: zähe Gegner (Faktoren in game.conf: temple_*). Anzahl = Anzahl [temple]-Abschnitte.
#   [ruins]    Ruinen: harte Gegner (game.conf: ruins_*).
#
# SCHLÜSSEL in [chapter]
#   name         Name des Kapitels
#   level_first  Monster-Level der ersten Karte (1 bis 100)
#   level_last   Monster-Level der letzten Karte
#   party        wie viele Helden gleichzeitig auf die Karten dürfen (1 oder 2)
# SCHLÜSSEL in [temple] und [ruins]
#   name, party  wie oben
#   map          welche der [map]-Karten genutzt wird (1 = erste)
#   level        Monster-Level
#   after_chapter  freigeschaltet, sobald dieses Kapitel (Nummer, 1 = erstes) komplett geschafft ist
# SCHLÜSSEL in [map]
#   name         interner Name (nur zur Orientierung)
#   start        x y winkel     Startpunkt der Helden und Blickrichtung (Grad)
#   spawn        x y [rolle]    ein Monster; rolle: normal (Standard), miniboss, boss
#   spawn_line   x1 y1 x2 y2 abstand [rolle]        Monster in gleichen Abständen entlang einer Linie
#   spawn_grid   x1 y1 x2 y2 abstand_x abstand_y [rolle]   Monster-Raster
#   waypoint     x y            Wegpunkt des Autopiloten (der Reihe nach abgelaufen)
#   Das Level-Ende wird durch den Tod des Bosses ausgelöst: jede Karte braucht mindestens einen boss.

[chapter]
name = Grenzland
level_first = 1
level_last = 10
party = 1

